{
  "name": "universal-metro-feed",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate:data": "node scripts/providers/mta/generate-static.mjs",
    "update:mbta-data": "node scripts/providers/gtfs/generate-catalog.mjs public/providers/mbta-subway.json",
    "update:nbrt-data": "node scripts/providers/nbrt/generate-catalog.mjs",
    "dev": "npm run generate:data && vite",
    "build": "npm run generate:data && tsc -b && vite build",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.87.1",
    "gtfs-realtime-bindings": "^2.2.0",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^5.0.0"
  }
}
