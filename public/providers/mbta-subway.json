  "refreshIntervalMs": 20000,
  "topology": {
    "kind": "gtfs-static",
    "sourceUrl": "https://cdn.mbta.com/MBTA_GTFS.zip",
    "catalogUrl": "/providers/mbta-subway/catalog.json",
    "routeTypes": [0, 1]
  },
  "schedule": {
    "kind": "proprietary-http",
    "adapter": "mbta-v3",
    "urlTemplate": "https://api-v3.mbta.com/schedules",
    "coverage": "full-day"
  },
  "predictions": {
    "kind": "proprietary-http",
    "adapter": "mbta-v3",
    "urlTemplate": "https://api-v3.mbta.com/predictions"
  }
}
